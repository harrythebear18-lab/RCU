# Homelab Tools Git Ignore - Only exclude truly unnecessary files

# Python cache files and compiled files
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/

# IDE files
.idea/
.vscode/
*.swp
*.swo
*~

# Log files
*.log
logs/
*.log.*

# Temporary files
temp/
tmp/
*.tmp
*.temp

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Performance data
performance_data/
monitoring_data/

# Configuration backups
*.bak
*.backup

# LFS cache
.git/lfs/objects/cache/
